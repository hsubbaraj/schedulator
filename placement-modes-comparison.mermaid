graph TB
    subgraph "Mode 1: ClusterOnly (Baseline)"
        S1[Scheduler Decision:<br/>cluster-2, 10 replicas]
        E1[Enforcer creates:<br/>Deployment in cluster-2]
        D1[Default kube-scheduler<br/>in cluster-2]
        N1[Pods placed on:<br/>node-3, node-5, node-7<br/>using standard K8s logic]
        
        S1 --> E1
        E1 --> D1
        D1 --> N1
        
        Note1[Use case: Test if global<br/>cluster selection helps<br/>vs independent clusters]
    end
    
    subgraph "Mode 2: NodePlacement (Advanced)"
        S2[Scheduler Decision:<br/>cluster-2, node-5: 4 pods<br/>cluster-2, node-7: 6 pods]
        E2[Enforcer creates:<br/>Pods with strict<br/>nodeAffinity or<br/>schedulerName: custom]
        P2[Custom Scheduler Plugin<br/>or Admission Webhook]
        N2[Pods placed on:<br/>EXACTLY node-5 and node-7<br/>as specified]
        
        S2 --> E2
        E2 --> P2
        P2 --> N2
        
        Note2[Use case: Bin-packing,<br/>GPU topology awareness,<br/>minimize fragmentation]
    end
    
    subgraph "Mode 3: Gang (Multi-node Jobs)"
        S3[Scheduler Decision:<br/>cluster-2, 8 pods<br/>for distributed training job]
        E3[Enforcer creates:<br/>PodGroup CRD<br/>minAvailable: 8<br/>All-or-nothing]
        G3[Gang Controller<br/>Kueue/Volcano]
        N3[Either:<br/>All 8 pods Running<br/>OR<br/>All 8 pods Pending<br/>No partial admission]
        
        S3 --> E3
        E3 --> G3
        G3 --> N3
        
        Note3[Use case: Distributed ML,<br/>MPI jobs, avoid deadlock<br/>from partial allocation]
    end
    
    subgraph "Key Differences"
        T1[ClusterOnly:<br/>✓ Fast decision<br/>✓ Default K8s handles nodes<br/>✗ No fine-grained control]
        
        T2[NodePlacement:<br/>✓ Full control<br/>✓ Optimal bin-packing<br/>✗ More complex<br/>✗ Scheduler must solve harder problem]
        
        T3[Gang:<br/>✓ Prevents deadlock<br/>✓ All-or-nothing semantics<br/>✗ Can lead to starvation<br/>✗ Requires admission controller]
    end
    
    subgraph "When to Use Each"
        U1[ClusterOnly:<br/>- High-level load balancing<br/>- Region/zone selection<br/>- Cost optimization<br/>- Simple deployments]
        
        U2[NodePlacement:<br/>- GPU type requirements<br/>- NVLink topology<br/>- Co-location constraints<br/>- Fragmentation minimization]
        
        U3[Gang:<br/>- Distributed training<br/>- Multi-replica services<br/>- Jobs needing all-or-nothing<br/>- Prevent partial failures]
    end
    
    style S1 fill:#e1f5ff
    style S2 fill:#e1f5ff
    style S3 fill:#e1f5ff
    style E1 fill:#fff4e1
    style E2 fill:#fff4e1
    style E3 fill:#fff4e1
    style D1 fill:#f0f0f0
    style P2 fill:#e8f5e9
    style G3 fill:#e8f5e9
    style N1 fill:#fff
    style N2 fill:#fff
    style N3 fill:#fff
    style Note1 fill:#ffebee
    style Note2 fill:#ffebee
    style Note3 fill:#ffebee
