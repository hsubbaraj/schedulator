graph LR
    subgraph Input["📥 Input"]
        Scenario[Scenario YAML<br/>────────<br/>Workloads<br/>Failures<br/>Timing]
    end

    subgraph Sim["🔄 Simulator"]
        State[State Manager<br/>────────<br/>Aggregate cluster state<br/>Version: v1689, v1690...]
        API[API<br/>────────<br/>GET /v1/state<br/>POST /v1/placement]
        Enforce[Enforcer<br/>────────<br/>Apply decisions<br/>to K8s]
    end

    subgraph Sched["🧠 Scheduler"]
        Logic[Decision Logic<br/>────────<br/>Pick one:<br/>• Random<br/>• Greedy<br/>• CP-SAT/ILP<br/>• Custom]
    end

    subgraph K8s["☸️ Kubernetes"]
        Clusters[3-10 Clusters<br/>────────<br/>Nodes: GPUs<br/>Pods: workloads<br/>Schedulers: in-cluster]
    end

    subgraph Output["📊 Output"]
        Metrics[Metrics<br/>────────<br/>Utilization<br/>Fragmentation<br/>Churn<br/>Latency]
        
        Logs[Decision Logs<br/>────────<br/>What was decided<br/>Why<br/>Alternatives]
    end

    %% Main flow
    Scenario -->|Define| Sim
    Clusters -.->|Watch| State
    State --> API
    API -->|1. GET state| Logic
    Logic -->|2. POST decision| API
    API --> Enforce
    Enforce -->|Create resources| Clusters
    
    %% Observability
    State --> Metrics
    Enforce --> Metrics
    Logic -.-> Logs
    Clusters -.-> Metrics

    %% Styling
    classDef input fill:#ffebee,stroke:#f44336,stroke-width:2px
    classDef simulator fill:#e1f5ff,stroke:#0066cc,stroke-width:3px
    classDef scheduler fill:#e8f5e9,stroke:#4caf50,stroke-width:3px
    classDef k8s fill:#fff4e1,stroke:#ff9800,stroke-width:2px
    classDef output fill:#f3e5f5,stroke:#9c27b0,stroke-width:2px

    class Scenario input
    class State,API,Enforce simulator
    class Logic scheduler
    class Clusters k8s
    class Metrics,Logs output
