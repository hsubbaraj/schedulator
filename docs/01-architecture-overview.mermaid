---
title: Multi-Cluster GPU Scheduler - Architecture Overview
---
flowchart TB
    subgraph External["External Dependencies"]
        CA[Cluster Aggregator<br/>pods/nodes/vLLM metrics]
        CR[Cache Registry<br/>tiered model locations]
        PP[Performance Profiler<br/>offline metrics]
    end

    subgraph Concrete["Concrete Implementations"]
        K8sAgg[K8s Aggregator<br/>client-go Informers<br/>Nodes + Pods watch]
        YAMLStore[YAML ConfigStore<br/>fsnotify file watcher<br/>apps.yaml]
    end

    subgraph GlobalScheduler["Global Scheduler"]
        subgraph EventIngestion["Event Ingestion Layer"]
            MEL[vLLM Metrics<br/>Listener]
            CEL[Cluster Event<br/>Listener]
            SBL[SLA Breach<br/>Listener]
            TIM[Timer<br/>periodic]
        end

        subgraph SchedulerCore["Scheduler Core"]
            subgraph WorldState["World State (in-memory)"]
                CT[Cluster<br/>Topology]
                AC[Application<br/>Configs]
                CS[Cache State<br/>tiered]
                VM[vLLM<br/>Metrics]
            end

            SE[Scaling Engine<br/>How many replicas?]
            PE[Placement Engine<br/>Which cluster, what affinity?]
            RE[Rebalancing Engine<br/>Consolidate fragmentation]
            PG[Plan Generator<br/>What ops to execute?]
        end

        CL[Control Loop<br/>Orchestrates full cycle<br/>Leader election gated]

        subgraph PlanExecutor["Plan Executor"]
            EC[Execution Coordinator<br/>• Orders operations<br/>• Tracks in-flight<br/>• Handles rollback]

            CC1[Cluster Client<br/>us-west-1]
            CC2[Cluster Client<br/>eu-central-1]
            CC3[Cluster Client<br/>ap-northeast]
        end

        subgraph Observability["Observability & API"]
            API[HTTP API Server<br/>REST + SSE stream]
            EL[Event Log<br/>SQLite persistence]
            DASH[React Dashboard<br/>Fleet visualization]
        end
    end

    subgraph Clusters["Kubernetes Clusters"]
        subgraph K8s1["us-west-1"]
            V1[Volcano<br/>In-cluster Scheduler]
            N1[Node 8GPU]
            N2[Node 8GPU]
            N3[...]
        end

        subgraph K8s2["eu-central-1"]
            V2[Volcano<br/>In-cluster Scheduler]
            N4[Node 8GPU]
            N5[Node 8GPU]
            N6[...]
        end

        subgraph K8s3["ap-northeast"]
            V3[Volcano<br/>In-cluster Scheduler]
            N7[Node 8GPU]
            N8[Node 8GPU]
            N9[...]
        end
    end

    %% Concrete implementations fulfill interfaces
    K8sAgg -.->|implements<br/>ClusterAggregator| CA
    YAMLStore -.->|implements<br/>ConfigStore| AC

    %% External to Event Ingestion / World State
    CA -->|vLLM metrics<br/>poll 10s| MEL
    CA -->|cluster state<br/>watch stream| CEL
    CR -->|cache state tiered<br/>poll 30s| WorldState
    PP -->|app profiles<br/>poll 5m| WorldState

    %% Event Ingestion to Control Loop
    MEL --> CL
    CEL --> CL
    SBL --> CL
    TIM --> CL

    %% Control Loop orchestrates engines
    CL --> SE
    CL --> PE
    CL --> RE
    CL --> PG

    %% Scheduler Core flow
    WorldState --> SE
    WorldState --> PE
    WorldState --> RE
    SE --> PE
    PE --> PG
    RE --> PG

    %% Plan Executor
    PG --> EC
    EC --> CC1
    EC --> CC2
    EC --> CC3

    %% Cluster Clients to K8s
    CC1 -->|k8s API| V1
    CC2 -->|k8s API| V2
    CC3 -->|k8s API| V3

    %% Volcano to Nodes
    V1 --> N1
    V1 --> N2
    V2 --> N4
    V2 --> N5
    V3 --> N7
    V3 --> N8

    %% Observability connections
    CL -->|events + snapshots| EL
    CL -->|publish events| API
    WorldState -->|snapshot| API
    EL -->|history + time-series| API
    API -->|SSE + REST| DASH
